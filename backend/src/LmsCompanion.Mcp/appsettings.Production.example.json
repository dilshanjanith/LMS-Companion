{
  "ConnectionStrings": {
    "LmsCompanion": "Host=<postgres-host>;Port=5432;Database=lms_companion;Username=<user>;Password=<from-secret-manager>"
  },
  "AllowedHosts": "<mcp-host>",
  "Authentication": {
    "Authority": "https://<auth0-tenant>.us.auth0.com/",
    "Audience": "https://<mcp-host>/mcp",
    "TenantClaim": "https://lms-companion.example/claims/tenant_id"
  },
  "Mcp": {
    "PublicResourceUri": "https://<mcp-host>/mcp"
  },
  "Frontend": {
    "ConnectionManagementUri": "https://<portal-host>/dashboard"
  },
  "DataProtection": {
    "KeyDirectory": "/var/lms-companion/dataprotection",
    "CertificatePath": "/var/lms-companion/dataprotection/cert.pfx",
    "CertificatePassword": "<from-secret-manager>"
  },
  "Lms": {
    "Provider": "Canvas",
    "AllowMockProvider": false
  },
  "Canvas": {
    "AllowPersonalTokenTesting": true,
    "Institutions": [
      {
        "Id": "stanford-seed",
        "Enabled": false,
        "TenantId": "<provisioned-tenant-guid>",
        "BaseUrl": "https://seedonline.stanford.edu/",
        "Name": "Stanford SEED"
      }
    ]
  }
}
